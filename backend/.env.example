# Database (Supabase Postgres, session-mode pooler recommended for async SQLAlchemy)
# This is the RUNTIME app role. In production it must NOT own the schema and must
# NOT have BYPASSRLS — it is the role every real request runs as, so if it could
# disable its own RLS policies, RLS would provide no real protection. Supabase's
# default `postgres` connection role is fine for local dev (where this distinction
# doesn't matter yet) but should be a dedicated least-privilege role in production.
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Elevated connection used ONLY by `alembic upgrade` and scripts/seed_dev_data.py —
# never by the deployed API process (nothing in app/db/session.py reads this).
# Needs schema ownership (to run CREATE TABLE / ALTER TABLE ... FORCE ROW LEVEL
# SECURITY / CREATE POLICY). Leave blank in local dev to fall back to DATABASE_URL;
# set explicitly in CI/production to a role separate from the runtime one above.
MIGRATIONS_DATABASE_URL=

# Supabase project (for JWT verification — service role key is server-only, never sent to frontend)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Redis (Celery broker/backend + caching)
REDIS_URL=redis://localhost:6379/0

# App
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-32-byte-secret
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Field-level encryption for stored third-party credentials (api_credentials table)
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
