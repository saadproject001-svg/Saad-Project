# Supabase project (same project the backend's SUPABASE_URL points at). The anon/
# publishable key is safe to expose client-side by design — Supabase enforces real
# access control via Postgres RLS, not by keeping this key secret. Never put the
# service role key here.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-public-key

# Base URL of this repo's FastAPI backend (backend/), including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1
